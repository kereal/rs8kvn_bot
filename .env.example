# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=123456789
CONTACT_USERNAME=billgates

# REQUIRED: Base URL for subscription links.
# Constructs full subscription URLs as GLOBAL_SUB_URL + <subscription_id> (e.g. https://vpn.example.com/sub/abc123).
# If left empty, subscription links will be broken.
GLOBAL_SUB_URL=https://vpn.example.com/sub/

# Database Configuration
DATABASE_PATH=./data/rs8kvn.db

# Logging Configuration
LOG_FILE_PATH=./data/bot.log
LOG_LEVEL=info

# Subscription /sub/{id} access log. Set empty to disable; startup continues if this file cannot be opened.
SUBSERVER_ACCESS_LOG=./data/subserver.log

# Heartbeat Configuration (optional)
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=300

# Sentry Error Tracking (optional)
# Get your DSN from Better Stack or Sentry dashboard
SENTRY_DSN=

# Health Check Configuration
WEB_SERVER_PORT=8880

# Trial & Referral Configuration
SITE_URL=https://vpn.site
TRIAL_DURATION_HOURS=3
TRIAL_RATE_LIMIT=3

# Donation Configuration (optional, uses defaults if not set)
DONATE_CARD_NUMBER=
DONATE_URL=
# Show "☕ Донат" button in the main menu. true / false (default: true).
DONATE_ENABLED=true

# Оплата (опционально)
# Включает оплату в боте. PLATEGA_MERCHANT_ID/PLATEGA_SECRET обязательны, когда Platega в работе:
# PAYMENT_ENABLED=true с PAYMENT_PROVIDER=platega или PLATEGA_CALLBACK_ENABLED=true.
# При PAYMENT_PROVIDER=telegram_stars без Platega-callback Platega-креды не нужны;
# тарифы берутся из товаров с currency='XTR' (цена в Stars).
PAYMENT_ENABLED=false
# Активный платёжный провайдер: platega (ссылки провайдера + webhook) или telegram_stars (счёт выставляет бот).
# По умолчанию: platega.
PAYMENT_PROVIDER=platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Оставить приём legacy HTTP-callback Platega после переключения на telegram_stars,
# чтобы досчитать старые заказы без новых продаж. По умолчанию: false.
PLATEGA_CALLBACK_ENABLED=false
# Локальный срок жизни Stars-invoice (Go duration, например 15m, 30m, 1h). По умолчанию: 15m.
STARS_INVOICE_TTL=15m

# User Notifications (expiry reminders + traffic notifications).
# Set false for local runs against a copy of the production database to prevent
# messages reaching real users. Default: true.
NOTIFICATIONS_ENABLED=true

# Audit log retention in days (default 180 = half a year; 0 = default).
AUDIT_LOG_RETENTION_DAYS=180

# Shared secret for /metrics (Authorization: Bearer <token>).
# Leave empty for local scraping; set it whenever the web port is public.
METRICS_TOKEN=
